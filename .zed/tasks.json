[
  {
    "label": "Nouvelle actualité",
    "command": "uv run invoke new",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Site : build",
    "command": "uv run invoke build",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Site : livereload",
    "command": "uv run invoke livereload",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
